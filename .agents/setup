#!/usr/bin/env bash
set -euo pipefail

SECONDS=0
echo 'Checking the pinned Node.js toolchain...'
version="$(cat .node-version)"
if ! command -v node >/dev/null 2>&1 || [[ "$(node --version)" != "v$version" ]]; then
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo 'Unsupported Node.js architecture' >&2; exit 1 ;;
  esac
  archive="node-v$version-linux-$arch"
  temp="$(mktemp -d)"
  trap 'rm -rf "$temp"' EXIT
  curl -fsSLo "$temp/$archive.tar.xz" "https://nodejs.org/dist/v$version/$archive.tar.xz"
  curl -fsSLo "$temp/SHASUMS256.txt" "https://nodejs.org/dist/v$version/SHASUMS256.txt"
  (cd "$temp" && grep " $archive.tar.xz$" SHASUMS256.txt | sha256sum --check)
  sudo tar -xJf "$temp/$archive.tar.xz" -C /opt
  for tool in node npm npx; do
    sudo ln -sfn "/opt/$archive/bin/$tool" "/usr/local/bin/$tool"
  done
fi

node --version
echo "Toolchain ready in ${SECONDS}s. Installing locked dependencies..."
npm ci --no-audit --no-fund
echo "Setup ready in ${SECONDS}s."
echo 'Start the preview with: amp orb services ensure'
